// Generic Updater 的 PE 资源：版本信息、图标、清单。
// @FILEVERSION@ / @VERSION_STRING@ 由 build-common 在构建期替换。
// 这里只写 ASCII，避免 rc.exe 的代码页问题。
//
// VERSIONINFO 必须用数字 ID 1 并且排在资源首位，否则
// GetFileVersionInfoSize / 资源管理器的"详细信息"读不到它。

1 VERSIONINFO
 FILEVERSION @FILEVERSION@
 PRODUCTVERSION @FILEVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Generic Updater Project\0"
            VALUE "FileDescription", "Generic Updater - external update service\0"
            VALUE "FileVersion", "@VERSION_STRING@\0"
            VALUE "InternalName", "generic-updater\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Generic Updater Project\0"
            VALUE "OriginalFilename", "generic-updater.exe\0"
            VALUE "ProductName", "Generic Updater\0"
            VALUE "ProductVersion", "@VERSION_STRING@\0"
            VALUE "Comments", "https://github.com/Luogoddes/openai-gemini\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 ICON "app.ico"
1 24 "updater.manifest"
